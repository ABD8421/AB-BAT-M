# ---------------------------------------------------------------------------
# CREDENTIAL INVENTORY  (spec §52–55)
# Copy to .env.local for development. NEVER commit .env.local.
# Values below are placeholders only.
# ---------------------------------------------------------------------------

# PUBLIC — safe to expose to the browser. Only genuinely public values here.
NEXT_PUBLIC_SITE_URL=https://ab-bat.vercel.app

# GitHub — server-side only.
# Purpose : raise the unauthenticated GitHub API rate limit (60/hr -> 5000/hr)
# Scope   : fine-grained token, PUBLIC repos, READ-ONLY metadata. No write scopes.
# Storage : Vercel project env vars (Production/Preview/Development separately)
# Rotation: every 90 days. Revoke at github.com/settings/tokens
# Optional: the site works without it and degrades gracefully.
GITHUB_TOKEN=
GITHUB_USERNAME=ABD8421

# Transactional email (contact form) — server-side only.
# Purpose : deliver contact-form submissions
# Scope   : send-only API key
# Rotation: every 90 days, immediate revoke on suspected leak
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional shared secret for a future webhook/revalidation endpoint
REVALIDATE_SECRET=
